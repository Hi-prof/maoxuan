"false" long-clickable="false" password="false" selected="false" bounds="[53,1606][197,1669]" /><node index="1" text="把全国胜利比作长征第一步，是提醒人们：一个重大阶段的完成，只是新任务的起点。取得政权之后，经济建设、城市工作和国家治理会提出更长、更复杂的要求。" resource-id="" class="android.widget.TextView" package="com.xuhuangbin.xinghuozhaidu" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1690][1027,1888]" /><node index="2" text="理解重点" resource-id="" class="android.widget.TextView" package="com.xuhuangbin.xinghuozhaidu" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1985][197,2048]" /><node index="3" text="这不是削弱胜利意义，而是反对因阶段成果而高估完成度。报告在胜利临近时强调谦虚、谨慎和艰苦奋斗，说明环境越有利，越要警惕骄傲和享乐。" resource-id="" class="android.widget.TextView" package="com.xuhuangbin.xinghuozhaidu" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,2069][1027,2267]" /><node index="4" text="现实启示" resource-id="" class="android.widget.TextView" package="com.xuhuangbin.xinghuozhaidu" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,2364][197,2400]" /></node></node></node></node></node></node></node></node></node></hierarchy>